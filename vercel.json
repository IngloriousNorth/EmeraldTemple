{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS, HEAD, POST, PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "Range, Content-Type, X-Requested-With" }
      ]
    }
  ]
}