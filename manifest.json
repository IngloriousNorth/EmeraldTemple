{
  "manifest_version": 3,
  "name": "EmeraldTemple",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js",
    "type" : "module"
  },
  "action": {
    "default_popup": "Mu.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/Gate.bundle.enc"],
      "matches": ["<all_urls>"]
    }
  ]
}